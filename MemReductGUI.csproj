<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>T-RamCash</AssemblyName>
    <RootNamespace>TRamCash</RootNamespace>
    <Version>1.2.0</Version>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
    <SatelliteResourceLanguages>en;tr;de</SatelliteResourceLanguages>

    <!-- Bellek: workstation + non-concurrent GC (ek GC thread'i ve arka plan yigini yok), PGO acik -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <!-- InvariantGlobalization KAPALI: arayuz Turkce kulturde ondalik (1,2 GB) bicimlendirir. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <EmbeddedResource Include="Assets\*.png" />
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- T-Suite SDK: kardes depo C:\Users\hp\Projects\t-suite (bkz. README.md) -->
  <PropertyGroup>
    <TSuiteRoot Condition="'$(TSuiteRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\Projects\t-suite</TSuiteRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Diagnostics\TSuite.Diagnostics.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Link\TSuite.Link.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Update\TSuite.Update.csproj" />
  </ItemGroup>

  <Import Project="$(TSuiteRoot)\build\TSuite.Updater.targets" />

  <Target Name="CheckLocalizedResources" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Check-Resources.ps1&quot;" />
  </Target>


  <ItemGroup>
    <EmbeddedResource Include="LICENSE" LogicalName="Legal.LICENSE" />
    <Content Include="LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="PRIVACY.md" LogicalName="Legal.PRIVACY.md" />
    <Content Include="PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="Legal.THIRD-PARTY-NOTICES.md" />
    <Content Include="THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
